add([w - rBR, h], [0, 0], [ctrlBR, 0]);
add([w, h - rBR], [0, ctrlBR], [0, 0]);
}
// Right side (only add top-right corner point if it's not rounded)
if (rTR == 0) {
add([w, 0], [0, 0], [0, 0]);
}
// Top Right Corner
if (rTR > 0) {
add([w, rTR], [0, 0], [0, -ctrlTR]);
add([w - rTR, 0], [ctrlTR, 0], [0, 0]);
